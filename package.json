{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3011",
    "build": "next build",
    "build:cloudflare": "vite build",
    "deploy:cloudflare": "vinext-cloudflare deploy --skip-build",
    "start": "next start -p 3011",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 lib/api.test.ts lib/maps.test.ts lib/pagination.test.ts lib/pwa.test.ts lib/recovery.test.ts lib/prototype/domain.test.ts",
    "format": "prettier --write app components features lib",
    "format:check": "prettier --check app components features lib"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@tailwindcss/vite": "4.3.3",
    "@vinext/cloudflare": "1.3.3",
    "@vitejs/plugin-react": "6.3.0",
    "@vitejs/plugin-rsc": "0.5.39",
    "cf": "1.0.0-beta.28",
    "@types/leaflet": "1.9.22",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vinext": "1.4.4",
    "vite": "8.3.6"
  }
}
